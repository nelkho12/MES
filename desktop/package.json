{
  "name": "mes-desktop",
  "version": "1.0.0",
  "description": "Standalone Desktop Wrapper for Manufacturing Execution System with Direct PostgreSQL IP Access",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.mes.desktop",
    "productName": "Manufacturing Execution System",
    "files": [
      "main.cjs",
      "../server.ts",
      "../src/**/*",
      "../dist/**/*",
      "../package.json",
      "../tsconfig.json",
      "../vite.config.ts"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "mac": {
      "target": ["dmg"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  }
}
